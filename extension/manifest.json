{
  "manifest_version": 3,
  "name": "FF Slot Machine",
  "version": "0.2.0",
  "description": "Finds ESPN fantasy trades and waiver adds that raise your projected starting-lineup points.",
  "permissions": ["storage", "unlimitedStorage", "cookies", "tabs", "alarms"],
  "host_permissions": [
    "https://lm-api-reads.fantasy.espn.com/*",
    "https://fantasy.espn.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/football/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Open FF Slot Machine" }
}
